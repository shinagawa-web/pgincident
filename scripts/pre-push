#!/bin/sh
# Pre-push hook: runs all checks before pushing.
# Bypass with: git push --no-verify

set -e

echo "==> Checking go.mod is tidy..."
go mod tidy
git diff --exit-code go.mod go.sum || {
  echo "go mod tidy produced changes — commit them first"
  exit 1
}

echo "==> Building..."
go build ./...

echo "==> Linting..."
go vet ./...

echo "==> Checking main.go is thin..."
MAIN_LINES=$(wc -l < cmd/pgincident/main.go)
if [ "$MAIN_LINES" -gt 15 ]; then
  echo "cmd/pgincident/main.go is too long (${MAIN_LINES} lines) — move logic to internal/"
  exit 1
fi

COVERAGE_TMP=$(mktemp)
trap 'rm -f "$COVERAGE_TMP"' EXIT

echo "==> Running unit tests..."
env -u DATABASE_URL go test -race -coverprofile="$COVERAGE_TMP" -covermode=atomic ./internal/...

echo "==> Checking coverage..."
COVERAGE=$(awk '/^mode:/ {next} {total += $(NF-1); if ($NF > 0) covered += $(NF-1)} END {if (total > 0) printf "%.1f", 100*covered/total}' "$COVERAGE_TMP")
if awk -v c="$COVERAGE" 'BEGIN { exit (c+0 < 100 ? 1 : 0) }'; then
  : # 100% ok
else
  echo "Coverage ${COVERAGE}% is below 100% — add tests before pushing"
  exit 1
fi

if [ -z "$DATABASE_URL" ]; then
  echo "DATABASE_URL is not set — integration tests are required before pushing."
  echo "Run 'make dev-up' to start Postgres, then set DATABASE_URL and retry."
  exit 1
fi
echo "==> Running integration tests..."
go test -race -v -timeout 2m -run Integration ./internal/core/...

echo "==> All checks passed."
